<%- include('partials/header') %>

<main>

    <h1><%= organizationDetails.name %></h1>

    <% if (user && user.role_name === "admin") { %>
        <p>
            <a href="/edit-organization/<%= organizationDetails.organization_id %>">
                Edit Organization
            </a>
        </p>
    <% } %>
    <img 
        src="/images/<%= organizationDetails.logo_filename %>" 
        alt="<%= organizationDetails.name %> logo"
    >

    <p>
        <%= organizationDetails.description %>
    </p>

    <p>
        Contact:
        <%= organizationDetails.contact_email %>
    </p>


    <h2>Service Projects</h2>

    <ul>
        <% projects.forEach(project => { %>
            <li>
                <a href="/project/<%= project.project_id %>">
                    <%= project.name %>
                </a>

                <% if (user && user.role_name === "admin") { %>
                    <a href="/edit-organization/<%= organizationDetails.id %>">
                        Edit
                    </a>
                <% } %>
                
            </li>
        <% }); %>
    </ul>

</main>

<%- include('partials/footer') %>