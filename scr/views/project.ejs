<%- include('partials/header') %>

<main>
    <a href="/edit-project/<%= project.project_id %>">
        Edit Project
    </a>
    <h1><%= project.name %></h1>

    <p>
        <%= project.description %>
    </p>

    <a href="/project/<%= project.project_id %>/assign-categories">
    Edit Categories
</a>

    <p>
        <strong>Organization:</strong>
        <a href="/organization/<%= project.organization_id %>">
            <%= project.organization_name %>
        </a>
    </p>

    <p>
        <strong>Date:</strong> <%= project.date %>
    </p>

    <p>
        <strong>Location:</strong> <%= project.location %>
    </p>


    <h2>Categories</h2>

    <ul>
        <% categories.forEach(category => { %>

            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
            </li>

        <% }); %>
    </ul>


</main>

<%- include('partials/footer') %>